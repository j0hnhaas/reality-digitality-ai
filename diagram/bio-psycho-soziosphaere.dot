digraph BioPsychoSoziosphaere {
  graph [
    charset="UTF-8",
    bgcolor="white",
    rankdir="TB",
    ranksep="0.20",
    pad="0.15",
    fontname="Arial"
  ];

  node [
    fontname="Arial"
  ];

  subgraph cluster_bio_psycho_soziosphaere {
    label="Bio-Psycho-Soziosphäre";
    labelloc="b";
    labeljust="c";
    fontsize="18";
    fontname="Arial";
    color="black";
    fontcolor="black";
    penwidth="1.4";
    style="solid";
    margin="14";

    subgraph cluster_technosphaere {
      label="Technosphäre";
      labelloc="t";
      labeljust="c";
      fontsize="18";
      fontname="Arial";
      color="black";
      fontcolor="black";
      penwidth="1.4";
      style="solid";
      margin="12";

      technosphaere_flaeche [
        label="",
        shape="box",
        width="9.50",
        height="3.50",
        fixedsize="true",
        style="invis"
      ];
    }

    zwischenraum_unten [
      label="",
      shape="box",
      width="9.50",
      height="0.65",
      fixedsize="true",
      style="invis"
    ];

    {
      rank="same";

      welt [
        label="Welt",
        shape="doublecircle",
        width="1.15",
        height="1.15",
        fixedsize="true",
        color="black",
        fontcolor="black",
        penwidth="1.4"
      ];

      abstand_welt_mensch [
        label="",
        shape="box",
        width="6.30",
        height="0.01",
        fixedsize="true",
        style="invis"
      ];

      mensch [
        label="Mensch",
        shape="circle",
        width="1.15",
        height="1.15",
        fixedsize="true",
        color="black",
        fontcolor="black",
        penwidth="1.4"
      ];
    }

    welt -> abstand_welt_mensch -> mensch [
      style="invis",
      weight="100"
    ];

    technosphaere_flaeche -> zwischenraum_unten -> abstand_welt_mensch [
      style="invis",
      weight="100"
    ];
  }
}
