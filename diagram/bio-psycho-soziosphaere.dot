digraph BioPsychoSoziosphaere {
  graph [
    charset="UTF-8",
    bgcolor="white",
    pad="0.25",
    fontname="Arial"
  ];

  subgraph cluster_bio_psycho_soziosphaere {
    label="Bio-Psycho-Soziosphäre";
    labelloc="t";
    labeljust="c";
    fontsize="22";
