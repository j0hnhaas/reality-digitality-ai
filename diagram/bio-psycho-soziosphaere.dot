digraph BioPsychoSoziosphaere {
  graph [
    charset="UTF-8",
    bgcolor="white",
    rankdir="TB",
    ranksep="0.20",
    pad="0.15",
    fontname="Arial"
  ];

  node [
    fontname="Arial"
  ];

  subgraph cluster_bio_psycho_soziosphaere {
    label="Bio-Psycho-Soziosphäre";
    labelloc="b";
    labeljust="c";
    fontsize="18";
    fontname="Arial";
    color="black";
    fontcolor="black";
    penwidth="1.4";
    style="solid";
    margin="14";

    subgraph cluster_technosphaere {
      label="Technosphäre";
      labelloc="t";
      labeljust="c";
      fontsize="18";
      fontname="Arial";
      color="black";
      fontcolor="black";
      penwidth="1.4";
      style="solid";
      margin="12";

      technosphaere_flaeche [
        label="",
        shape="box",
        width="9.50",
        height="3.50",
        fixedsize="true",
        style="invis"
      ];
    }

    untere_flaeche [
      label="",
      shape="box",
      width="9.50",
      height="2.00",
      fixedsize="true",
      style="invis"
    ];

    technosphaere_flaeche -> untere_flaeche [
      style="invis",
      weight="100"
    ];
  }
}
